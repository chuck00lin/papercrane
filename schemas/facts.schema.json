{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "papercrane/facts",
  "title": "Frozen facts emitted by one run",
  "type": "object",
  "required": ["experiment", "run", "provenance", "facts"],
  "additionalProperties": false,
  "properties": {
    "experiment": {"type": "string"},
    "run": {"type": "string"},
    "provenance": {
      "type": "object", "required": ["codespace", "code_commit", "command", "inputs", "produced_at"],
      "properties": {
        "codespace": {"type": "string"},
        "code_commit": {"type": "string", "minLength": 7},
        "command": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"]}},
        "produced_at": {"type": "string", "format": "date-time"}
      }
    },
    "facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "kind", "value", "definition"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^EXP-[0-9]{3}[a-z0-9-]*\\.r[0-9]{2,}\\.[a-z][a-z0-9_]*$"},
          "name": {"type": "string"},
          "kind": {"enum": ["metric", "count", "date", "interval", "string", "table"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "n": {"type": ["integer", "null"]},
          "definition": {"type": "string", "maxLength": 300},
          "supersedes": {"type": "string", "description": "fact id this value corrects; must also appear in reality/errata.md"}
        }
      }
    }
  }
}
